<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kairos.App.Views.TodayPage"
             Title="오늘"
             xmlns:conv="clr-namespace:Kairos.App.Converters">

    <ContentPage.Resources>
        <conv:PriorityTextConverter x:Key="PriorityText" />
        <conv:PriorityColorConverter x:Key="PriorityColor" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="오늘 할 일"
               FontSize="28"
               FontAttributes="Bold" />

        <CollectionView x:Name="TodoList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 우선순위 뱃지 -->
                        <Label Grid.Column="0"
                   Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                   TextColor="{Binding Priority, Converter={StaticResource PriorityColor}}"
                   FontAttributes="Bold"
                   FontSize="14"
                   VerticalOptions="Center" />

                        <Label Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="18"
                   VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>