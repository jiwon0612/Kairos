<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kairos.App.Views.TodoPage"
             Title="할 일">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label x:Name="ProjectTitle"
               Text="프로젝트"
               FontSize="24"
               FontAttributes="Bold" />

        <Entry x:Name="TitleEntry"
               Placeholder="새 할 일" />

        <Button Text="추가"
                Clicked="OnAddClicked" />

        <CollectionView x:Name="TodoList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                  CheckedChanged="OnCheckChanged" />

                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="18"
                               VerticalOptions="Center" />

                        <Button Grid.Column="2"
                                Text="수정"
                                FontSize="12"
                                Padding="10,0"
                                HeightRequest="36"
                                BackgroundColor="SteelBlue"
                                Clicked="OnEditTodo" />

                        <Button Grid.Column="3"
                                Text="삭제"
                                FontSize="12"
                                Padding="10,0"
                                HeightRequest="36"
                                BackgroundColor="IndianRed"
                                Clicked="OnDeleteTodo" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>