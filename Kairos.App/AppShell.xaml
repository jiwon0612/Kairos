<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Kairos.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Kairos.App"
    xmlns:views="clr-namespace:Kairos.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Kairos.App">

    <!-- 로그인 (탭 없이 단독) -->
    <ShellContent
        Title="로그인"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- 메인: 하단 탭 -->
    <TabBar Route="Main">
        <ShellContent
            Title="오늘"
            ContentTemplate="{DataTemplate views:TodayPage}"
            Route="TodayPage" />
        <ShellContent
            Title="프로젝트"
            ContentTemplate="{DataTemplate views:ProjectHubPage}"
            Route="ProjectHubPage" />
    </TabBar>

</Shell>